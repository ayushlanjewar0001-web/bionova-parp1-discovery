# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
node_modules/
web/node_modules/

# Unit test / coverage
.coverage
htmlcov/
.pytest_cache/

# Large raw datasets and external caches
data/raw/*.gz
data/raw/*.parquet
data/raw/*.zip
data/raw/*.tar
data/raw/*.xz
!data/raw/.gitkeep

# Checkpoints and large weights
checkpoints/*.pt
checkpoints/*.ckpt
models/*.pt
models/*.ckpt
!checkpoints/.gitkeep
!models/.gitkeep

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Binaries
bin/*.exe

# Logs
logs/*.log
!logs/.gitkeep

# Vercel
.vercel/
web/.vercel/
